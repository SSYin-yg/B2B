{
  "kind": "collectionType",
  "collectionName": "equipments",
  "info": {
    "singularName": "equipment",
    "pluralName": "equipments",
    "displayName": "设备",
    "description": "设备目录（含中英文名称、规格参数、SEO 等）"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "displayName": "URL 标识 (slug)"
    },
    "name_cn": {
      "type": "string",
      "required": true,
      "displayName": "中文名称"
    },
    "name_en": {
      "type": "string",
      "required": true,
      "displayName": "英文名称"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "mobile",
        "crushing",
        "screening",
        "washing",
        "parts"
      ],
      "required": true,
      "displayName": "设备类别",
      "enumNames": [
        "移动破碎",
        "破碎设备",
        "筛分设备",
        "洗选设备",
        "配件"
      ]
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "videos",
        "files"
      ],
      "displayName": "图片"
    },
    "desc_zh": {
      "type": "text",
      "displayName": "中文描述"
    },
    "desc_en": {
      "type": "text",
      "displayName": "英文描述"
    },
    "features_zh": {
      "type": "component",
      "component": "equip.feature",
      "repeatable": true,
      "displayName": "中文产品特点"
    },
    "features_en": {
      "type": "component",
      "component": "equip.feature",
      "repeatable": true,
      "displayName": "英文产品特点"
    },
    "specs": {
      "type": "component",
      "component": "equip.spec",
      "repeatable": true,
      "displayName": "主要参数"
    },
    "model_tables": {
      "type": "component",
      "component": "equip.model-table",
      "repeatable": true,
      "displayName": "型号参数表"
    },
    "model_tables_grid": {
      "type": "customField",
      "customField": "plugin::equip-editor.model-tables",
      "displayName": "型号参数表（可视化）"
    },
    "seo_title_zh": {
      "type": "string",
      "displayName": "SEO 标题（中文）"
    },
    "seo_title_en": {
      "type": "string",
      "displayName": "SEO 标题（英文）"
    },
    "seo_description_zh": {
      "type": "text",
      "displayName": "SEO 描述（中文）"
    },
    "seo_description_en": {
      "type": "text",
      "displayName": "SEO 描述（英文）"
    },
    "og_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "displayName": "社交分享图"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "sec.heading",
        "sec.rich-text",
        "sec.image",
        "sec.gallery",
        "sec.list",
        "sec.table",
        "sec.spec-table"
      ],
      "displayName": "正文内容（自由编排：标题/富文本/图片/图片组/列表/普通表格/规格表）"
    },
    "related_equipments": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::equipment.equipment",
      "displayName": "相关设备"
    },
    "ui_section_basic": {
      "type": "json",
      "customField": "plugin::equip-editor.section",
      "displayName": "分节：基本信息"
    },
    "ui_section_profile": {
      "type": "json",
      "customField": "plugin::equip-editor.section",
      "displayName": "分节：产品资料"
    },
    "ui_section_content": {
      "type": "json",
      "customField": "plugin::equip-editor.section",
      "displayName": "分节：正文内容"
    },
    "ui_section_params": {
      "type": "json",
      "customField": "plugin::equip-editor.section",
      "displayName": "分节：产品参数"
    },
    "ui_section_related": {
      "type": "json",
      "customField": "plugin::equip-editor.section",
      "displayName": "分节：相关设备"
    },
    "ui_section_seo": {
      "type": "json",
      "customField": "plugin::equip-editor.section",
      "displayName": "分节：SEO"
    }
  }
}
