HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database（当前生产：PostgreSQL 17；全部必填，见 docs/09）
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi_db
DATABASE_USERNAME=strapi_user
DATABASE_PASSWORD=changeMe
DATABASE_SSL=false
DATABASE_SCHEMA=public

# SMTP 询盘邮件转发（必填后询盘才会发邮件；留空则仅入库）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SALES_EMAIL=sales@minelink.cn

# 询盘重发接口密钥（POST /api/inquiry/resend 的 x-retry-key，生成：openssl rand -hex 16）
RETRY_KEY=generateRandom32Hex

# 站点地址（sitemap/绝对链接用，结尾带 /；IP 变更用 scripts/update-site-url.sh）
SITE_URL=http://your-domain-or-ip/

# 前端预览兜底地址（结尾不带 /；可留空，预览 URL 优先动态取访问 Host）
CLIENT_URL=
